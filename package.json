{
	"name": "minimax-bot",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"start": "npx tsx src/index.ts",
		"dev": "npx tsx watch src/index.ts",
		"generate": "npx tsx src/schedule_generation.ts",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@maxhub/max-bot-api": "^0.2.1",
		"better-sqlite3": "^12.4.1",
		"canvas": "^3.2.0",
		"dotenv": "^16.0.0",
		"tsx": "^4.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.10.1",
		"@vitest/ui": "^4.0.9",
		"happy-dom": "^20.0.10",
		"typescript": "^5.1.6",
		"vitest": "^4.0.9"
	}
}
